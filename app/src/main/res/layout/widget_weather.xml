<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/weather_widget_background">
 <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#F1F8FF" android:maxLines="1" android:ellipsize="end" />
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#ADC3D7" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_icon" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/weather_no_data" android:importantForAccessibility="yes" />
  <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="42sp" android:textColor="#F1F8FF" />
  <TextView android:id="@+id/widget_condition" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="18sp" android:textColor="#F1F8FF" />
 </LinearLayout>
 <TextView android:id="@+id/widget_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#D8E7F4" />
 <LinearLayout android:id="@+id/widget_solar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/widget_sunrise_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/weather_sunrise" android:contentDescription="@string/weather_sunrise" />
  <TextView android:id="@+id/widget_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ADC3D7" android:textSize="12sp" />
  <ImageView android:id="@+id/widget_sunset_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/weather_sunset" android:contentDescription="@string/weather_sunset" />
  <TextView android:id="@+id/widget_sunset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ADC3D7" android:textSize="12sp" />
 </LinearLayout>
 <TextView android:id="@+id/widget_hours_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/weather_hours" android:textSize="12sp" android:textColor="#ADC3D7" />
 <LinearLayout android:id="@+id/widget_hours" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
 <TextView android:id="@+id/widget_days_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/weather_days" android:textSize="12sp" android:textColor="#ADC3D7" />
 <LinearLayout android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
 <TextView android:id="@+id/widget_attribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/weather_attribution" android:textSize="10sp" android:textColor="#ADC3D7" />
</LinearLayout>
