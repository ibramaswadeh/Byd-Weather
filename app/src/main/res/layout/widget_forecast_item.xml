<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
 <TextView android:id="@+id/forecast_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#D8E7F4" android:maxLines="1" />
 <ImageView android:id="@+id/forecast_icon" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="yes" />
 <TextView android:id="@+id/forecast_temperature" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="14sp" android:textColor="#F1F8FF" android:maxLines="1" />
 <TextView android:id="@+id/forecast_precipitation" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" android:textColor="#76C7FF" android:maxLines="3" />
</LinearLayout>
